# Copy this file to `.env` and fill in your values.
# Vite only reads env at startup — restart the dev server after changes.

# ────────────────────────────────────────────────────────────
# Lovable Cloud (managed Supabase — do NOT edit these by hand
# in the live .env, Lovable manages them automatically).
# ────────────────────────────────────────────────────────────
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ────────────────────────────────────────────────────────────
# External Supabase project (admin panel, promoters, payments,
# payment_links). Used by `src/integrations/external-supabase.ts`.
# Get them from: <external project> → Project Settings → API.
# ────────────────────────────────────────────────────────────
VITE_EXTERNAL_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_EXTERNAL_SUPABASE_ANON_KEY=
